<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>SJEE workspace numeric approximation</title>
    <id>http://www.zotero.org/styles/sjee-workspace-numeric-approximation</id>
    <updated>2026-10-12T00:00:00+00:00</updated>
  </info>
  <!-- Local conversion aid, not an official journal CSL style. -->
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography hanging-indent="true">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <group delimiter=", " suffix=".">
        <names variable="author"><name initialize-with=". " name-as-sort-order="all"/></names>
        <text variable="title"/>
        <text variable="container-title" font-style="italic"/>
        <text variable="volume" prefix="Vol. "/>
        <text variable="issue" prefix="No. "/>
        <date variable="issued"><date-part name="year"/></date>
        <text variable="page" prefix="pp. "/>
        <text variable="publisher"/>
        <text variable="DOI" prefix="doi: "/>
        <text variable="URL"/>
        <text variable="note"/>
      </group>
    </layout>
  </bibliography>
</style>
